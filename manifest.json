{
  "manifest_version": 3,
  "name": "ETC走行ダッシュボード",
  "version": "0.1.0",
  "description": "ETC利用照会サービスの明細をローカルに取り込み、走行ダッシュボードとして表示します。",
  "icons": {
    "16": "public/icon16.png",
    "48": "public/icon48.png",
    "128": "public/icon128.png"
  },
  "permissions": ["storage", "tabs"],
  "host_permissions": ["https://www.etc-meisai.jp/*"],
  "background": {
    "service_worker": "src/background/index.ts",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": ["https://www.etc-meisai.jp/*"],
      "js": ["src/content/main.tsx"],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_title": "ETC走行ダッシュボード"
  },
  "chrome_url_overrides": {},
  "web_accessible_resources": []
}
